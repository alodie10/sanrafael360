# San Rafael 360 - Configuración de Entorno Universal
# Copiar a backend/.env y frontend/.env.local según corresponda.

## 🌍 Frontend (Next.js) — frontend/.env.local
# URL del backend Strapi SIN /api al final (local o Railway)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Token de API generado en Strapi > Settings > API Tokens (Full Access)
STRAPI_API_TOKEN=TU_TOKEN_AQUI
# Secreto de sesión NextAuth (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=genera_un_secreto_largo_aqui
# URL base del frontend (local o Vercel)
NEXTAUTH_URL=http://localhost:3000
# Llave de Google Maps (Requerida para Mapas Interactivos)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# OAuth Google (opcional en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## 🧪 Tests E2E (frontend/.env.test.local — no commitear)
TEST_USER_EMAIL=tu_usuario_test@example.com
TEST_USER_PASSWORD=tu_password_local
TEST_ADMIN_EMAIL=tu_admin_local@example.com
TEST_ADMIN_PASSWORD=tu_password_admin_local

## 📦 Backend (Strapi 5) — backend/.env
# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Secrets (Generar con: openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=salt_here
ADMIN_JWT_SECRET=secret_here
TRANSFER_TOKEN_SALT=salt_here
JWT_SECRET=usersecret1
ENCRYPTION_KEY=encryption_key_here

# Database (Local Docker - PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sanrafael_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Media Configuration (Cloudinary — obligatorio, sin fallbacks)
CLOUDINARY_NAME=tu_cloud_name
CLOUDINARY_KEY=tu_api_key
CLOUDINARY_SECRET=tu_api_secret

# Email (Resend — obligatorio para envío de correos)
RESEND_API_KEY=re_tu_api_key
RESEND_DEFAULT_FROM=no-reply@sanrafael360.com
RESEND_DEFAULT_REPLY_TO=admin@sanrafael360.com

# Integraciones opcionales
GOOGLE_MAPS_API_KEY=AIza...
MP_ACCESS_TOKEN=
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ADMIN_EMAILS=hola@sanrafael360.com
