{
  "kind": "collectionType",
  "collectionName": "efemerides",
  "info": {
    "singularName": "efemeride",
    "pluralName": "efemerides",
    "displayName": "Efemérides y Ferias",
    "description": "Fecha conmemorativa o feria temporal, con encabezado, slug, vigencia y participantes"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["efemeride", "feria"],
      "default": "efemeride"
    },
    "descripcion": {
      "type": "text",
      "description": "Texto del encabezado público"
    },
    "encabezado": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Imagen de portada del encabezado público"
    },
    "vigente_desde": {
      "type": "datetime",
      "description": "Inicio de vigencia (opcional). Si está vacío, vale desde que se publica."
    },
    "vigente_hasta": {
      "type": "datetime",
      "description": "Fecha tope. Pasada esta fecha deja de mostrarse en público."
    },
    "negocios": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::negocio.negocio",
      "inversedBy": "efemerides"
    },
    "participantes_externos": {
      "type": "component",
      "repeatable": true,
      "component": "efemeride.participante-externo",
      "description": "Listado libre de emprendimientos que no figuran en SR360 (ferias)"
    }
  }
}
