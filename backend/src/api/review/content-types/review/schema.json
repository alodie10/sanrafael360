{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Reseñas de usuarios para los negocios"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "comentario": {
      "type": "text",
      "required": true
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "negocio": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::negocio.negocio",
      "inversedBy": "reviews"
    }
  }
}
