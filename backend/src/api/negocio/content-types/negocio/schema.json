{
  "kind": "collectionType",
  "collectionName": "negocios",
  "info": {
    "singularName": "negocio",
    "pluralName": "negocios",
    "displayName": "Negocio",
    "description": "Directorio de negocios de San Rafael 360"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "descripcion": {
      "type": "richtext"
    },
    "direccion": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "website": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "latitud": {
      "type": "float"
    },
    "longitud": {
      "type": "float"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imagen_portada": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "galeria": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "negocios"
    },
    "verificado": {
      "type": "boolean",
      "default": false
    },
    "reclamar_habilitado": {
      "type": "boolean",
      "default": false,
      "description": "Toggle: habilita que el dueño reclame este perfil"
    },
    "horario_apertura": {
      "type": "json",
      "description": "Objeto JSON con horarios por día de la semana"
    },
    "reserva_url": {
      "type": "string"
    },
    "google_maps_url": {
      "type": "string"
    },
    "reserva_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el bot\u00f3n de reserva debe mostrarse"
    },
    "discovery_pending": {
      "type": "boolean",
      "default": true
    },
    "discovery_verified": {
      "type": "boolean",
      "default": false
    },
    "horarios_texto": {
      "type": "string"
    },
    "trigger_discovery": {
      "type": "boolean",
      "default": false,
      "description": "Activa manualmente el escaneo de Google Maps"
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "estado_reclamo": {
      "type": "string",
      "default": "ninguno",
      "description": "Estado actual del proceso de reclamo del negocio"
    },
    "documentacion_reclamo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ],
      "description": "Archivo PDF o imagen para verificar la propiedad del negocio"
    },
    "price_range": {
      "type": "enumeration",
      "enum": [
        "Economico",
        "Moderado",
        "Medio-Alto",
        "Alto"
      ]
    },
    "schedules": {
      "type": "component",
      "repeatable": true,
      "component": "shared.schedule"
    },
    "views": {
      "type": "biginteger",
      "default": "0"
    },
    "clicks_whatsapp": {
      "type": "integer",
      "default": 0
    },
    "clicks_website": {
      "type": "integer",
      "default": 0
    },
    "rating": {
      "type": "float",
      "default": 0
    },
    "review_count": {
      "type": "integer",
      "default": 0
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "negocio"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el negocio tiene una suscripción premium activa"
    },
    "premium_since": {
      "type": "datetime",
      "description": "Fecha de inicio original de la suscripción premium"
    },
    "premium_valid_until": {
      "type": "datetime",
      "description": "Fecha de vencimiento de la suscripción premium"
    },
    "premium_notes": {
      "type": "text",
      "description": "Notas administrativas sobre los pagos (ej: Pago efectivo 15/05)"
    }
  }
}
