{
  "kind": "collectionType",
  "collectionName": "atributos",
  "info": {
    "singularName": "atributo",
    "pluralName": "atributos",
    "displayName": "Atributo",
    "description": "Tags, facilidades y características de los negocios"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "tag",
        "facilidad",
        "ambiente",
        "servicio",
        "otro"
      ],
      "default": "tag"
    },
    "icono": {
      "type": "string",
      "description": "Nombre del ícono Lucide en kebab-case, por ejemplo wifi"
    },
    "rubros": {
      "type": "json",
      "description": "Rubros del amenity: alojamiento, gastronomia, comercios. Vacío en los tags de categoría."
    },
    "negocios": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::negocio.negocio",
      "mappedBy": "atributos"
    }
  }
}
