{
  "kind": "collectionType",
  "collectionName": "reserva_comercios",
  "info": {
    "singularName": "reserva-comercio",
    "pluralName": "reserva-comercios",
    "displayName": "Reserva Comercio",
    "description": "Comercio del módulo de reservas (dominio separado del directorio)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "nombre_publico": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "timezone": {
      "type": "string",
      "default": "America/Argentina/Mendoza"
    },
    "duracion_minutos": {
      "type": "integer",
      "default": 60,
      "required": true
    },
    "buffer_limpieza_minutos": {
      "type": "integer",
      "default": 0
    },
    "anticipacion_llegada_minutos": {
      "type": "integer",
      "default": 15
    },
    "texto_llegada": {
      "type": "text"
    },
    "precio_ars": {
      "type": "decimal",
      "required": true
    },
    "horario": {
      "type": "json",
      "required": true
    },
    "cancelacion_horas_minimas": {
      "type": "integer",
      "default": 24
    },
    "cancelacion_politica": {
      "type": "json"
    },
    "hold_ttl_minutos": {
      "type": "integer",
      "default": 15
    },
    "mp_token_env": {
      "type": "string"
    },
    "mp_access_token_enc": {
      "type": "text",
      "private": true
    },
    "mp_token_hint": {
      "type": "string",
      "private": true
    },
    "modo_simulacion": {
      "type": "boolean",
      "default": false
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imagen_portada": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "negocio": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::negocio.negocio",
      "inversedBy": "reserva_comercio",
      "description": "Vínculo blando opcional al directorio (portal dueño). Dominio de agenda sigue separado."
    },
    "recursos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reserva-recurso.reserva-recurso",
      "mappedBy": "comercio"
    },
    "reservas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reserva.reserva",
      "mappedBy": "comercio"
    },
    "bloqueos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reserva-bloqueo.reserva-bloqueo",
      "mappedBy": "comercio"
    }
  }
}
