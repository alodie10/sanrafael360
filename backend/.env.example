# Server Configuration
HOST=0.0.0.0
PORT=1337

# Secrets (Generar con: openssl rand -base64 32)
APP_KEYS="key_1,key_2,key_3,key_4"
API_TOKEN_SALT=salt_here
ADMIN_JWT_SECRET=secret_here
TRANSFER_TOKEN_SALT=salt_here
JWT_SECRET=secret_here
ENCRYPTION_KEY=encryption_key_here

# Database (Local Docker - PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sanrafael_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Media Configuration (Cloudinary para persistencia en Railway)
CLOUDINARY_NAME=tu_cloud_name
CLOUDINARY_KEY=tu_api_key
CLOUDINARY_SECRET=tu_api_secret

# Email (Resend — obligatorio)
RESEND_API_KEY=re_tu_api_key
RESEND_DEFAULT_FROM=no-reply@sanrafael360.com
RESEND_DEFAULT_REPLY_TO=admin@sanrafael360.com

# Front público (links de mail, baja de avisos, back_urls MP)
FRONTEND_URL=http://localhost:3000

# URL pública del backend (webhook MP). En local con sandbox real: URL del túnel (cloudflared/ngrok).
BACKEND_URL=http://localhost:1337

# Admins soberanos (emails separados por coma, minúsculas)
ADMIN_EMAILS=hola@sanrafael360.com

# Mercado Pago (premium / plataforma SR360)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Mercado Pago — módulo reservas (cuenta Jaditek; Access Token de *prueba* para sandbox)
MP_ACCESS_TOKEN_JADITEK=

# Cifrado de Access Token pegado desde el portal (64 hex = 32 bytes). Obligatorio para D1.
# openssl rand -hex 32
MP_TOKEN_ENCRYPTION_KEY=

# Dueño portal de Jaditek (separado del Master Admin para probar puerta owner)
JADITEK_OWNER_EMAIL=argendeli01@gmail.com
# WhatsApp del negocio Jaditek (cancelación self-service → wa.me). Ej: 5492604123456
# JADITEK_WHATSAPP=

# Kill switch de seguridad para reducir superficie de ataque cuando no se usan pagos.
# - Permite pagos si está vacío/no definido.
# - Bloquea rutas públicas de pagos premium si es '0' o 'false'.
# Nota: el checkout de reservas usa modo_simulacion del comercio o este token Jaditek.
ENABLE_PAYMENTS=false

# Búsqueda Algolia
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# Feed Meta Commerce
FEED_SECRET_TOKEN=dev-token-local

GOOGLE_MAPS_API_KEY=AIza...
