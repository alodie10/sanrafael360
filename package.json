{
  "//": "Trigger build v13 - Schema Fix (autor)",
  "name": "sanrafael360-monorepo",
  "version": "1.2.0",
  "description": "Repositorio centralizado para San Rafael 360 (Next.js + Strapi)",
  "scripts": {
    "start": "cd backend && npm run start",
    "build": "npm run build:all",
    "build:all": "rm -rf backend/dist backend/.strapi && cd backend && npm install && npm run build && cd ../frontend && npm install && npm run build",
    "info": "echo 'Proyecto San Rafael 360. Desarrollo 100% Remoto.'",
    "test:unit": "cd backend && npm run test:unit",
    "test:integration": "cd backend && npm run test:integration",
    "test:fast": "npm run test:unit && npm run test:integration",
    "test:e2e:setup": "cd frontend && npm run test:e2e:setup",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:e2e:smoke": "cd frontend && npm run test:e2e:smoke",
    "test:e2e:smoke:local": "cd frontend && npm run test:e2e:smoke:local",
    "test:e2e:headed": "cd frontend && npm run test:e2e:headed",
    "test:all": "npm run test:fast && npm run test:e2e"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.11.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "lodash": "4.18.1",
    "ws": "8.18.2",
    "axios": "1.18.1",
    "serialize-javascript": "6.0.2",
    "uuid": "11.1.0"
  }
}
